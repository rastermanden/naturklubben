# Kopiér til .env.local og udfyld. Værdien får du ved at køre `npx convex dev`
# i V2/ -- den skriver den også selv i .env.local første gang.
# Se V2/README.md, "Kom i gang".

VITE_CONVEX_URL=

# Deploymentets HTTP-endpoint (.convex.site), hvor de offentlige ruter ligger:
# iCal-feedet, gæsteformularen og prøvemedlemskabets ansøgningsformular.
# Uden den kan formularen på /proevemedlemskab ikke indsende noget.
VITE_CONVEX_SITE_URL=
