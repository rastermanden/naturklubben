{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.worker.tsbuildinfo",
    "target": "es2023",
    /* Service workeren kører i WebWorker-scope, ikke i DOM'et. DOM og
       WebWorker kan ikke være i samme lib-sæt uden navnesammenstød, så
       src/sw.ts typecheckes i sit eget projekt og er ekskluderet fra
       tsconfig.app.json. */
    "lib": ["ES2023", "WebWorker"],
    "module": "esnext",
    "types": ["vite/client"],
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,

    /* Linting */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src/sw.ts"]
}
